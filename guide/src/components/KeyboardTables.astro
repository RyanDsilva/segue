---
// The keyboard reference, generated from the app's own tables (WS6 4.6): menu key
// equivalents from MenuShortcuts, editor keys from EditorKeys and stage keys from KeyHelp
// with the default bindings.
import keyboard from '../data/keyboard.json';

interface Props {
  part: 'menus' | 'stage' | 'editor';
}

const { part } = Astro.props;
const groups =
  part === 'menus'
    ? keyboard.menus.map((menu) => ({ title: `${menu.menu} menu`, rows: menu.items }))
    : part === 'editor'
      ? [{ title: 'Editor', rows: keyboard.editor }]
      : keyboard.stage.map((group) => ({ title: group.group, rows: group.rows }));
---

{
  groups.map((group) => (
    <div class="keys-group">
      <h3>{group.title}</h3>
      <table>
        <tbody>
          {group.rows.map((row) => (
            <tr>
              <td>{row.title}</td>
              <td>{row.keys.length ? row.keys.map((key) => <kbd>{key}</kbd>) : 'Not set'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ))
}
