---
// One workflow tile on Getting started (direction C, the landing page's rounded tiles).
import shots from '../data/shots.json';

interface Props {
  number: string;
  title: string;
  href: string;
  /** Shot id for the tile's art (top-left crop). */
  shot: string;
}

const { number, title, href, shot } = Astro.props;
const entry = (shots.shots as Record<string, { appearances: string[] }>)[shot];
const base = `${import.meta.env.BASE_URL}/shots/${shot}`;
const one = entry && entry.appearances.length === 1;
---

<a class="tile" href={href}>
  <span class="tile-number">{number}</span>
  <span class="tile-title">{title}</span>
  <span class="tile-body"><slot /></span>
  <span class="tile-art">
    {
      entry ? (
        <picture>
          {!one && <source srcset={`${base}-dark.avif`} media="(prefers-color-scheme: dark)" />}
          <img src={one ? `${base}.avif` : `${base}-light.avif`} alt="" width="640" height="272" loading="lazy" />
        </picture>
      ) : (
        <span class="placeholder" data-placeholder />
      )
    }
  </span>
</a>
