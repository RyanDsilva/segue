# macOS
.DS_Store

# Tuist-generated Xcode artefacts (manifests are the source of truth)
*.xcodeproj
*.xcworkspace
Derived/
Tuist/.build/
.tuist-derived/
graph.dot
graph.png

# Build output
.build/
DerivedData/
build/
*.xcresult

# SwiftPM per-user state
.swiftpm/
Packages/*/.swiftpm/

# Xcode per-user state
xcuserdata/
*.xcuserstate

# VS Code per-user state (the Swift extension writes launch.json on its own; untracked
# files there made make gate run the full E2E suite)
.vscode/

# Local signing overrides (not used yet; see Project.swift)
Tuist/Signing.xcconfig

# Signing and upload credentials never enter the repo (they live in 1Password; WS1 4.6).
*.p8
AuthKey_*.p8
*.p12
*.cer
*.certSigningRequest
*.provisionprofile

# Per-agent SwiftPM scratch paths
.build-*/
.claude/settings.local.json

# Regenerated by make icon
design/icon/previews/

# Local Cloudflare Pages preview state (make site-serve)
.wrangler/

# Python bytecode (research spikes)
__pycache__/

# Phase 3 spike harness outputs: downloaded models, xcodebuild DerivedData,
# SwiftPM build dir and compiled binaries (the sources stay tracked)
research/phase3-spikes/models/
research/phase3-spikes/dd/
research/phase3-spikes/Spike/.build/
research/phase3-spikes/avail
research/phase3-spikes/bench
research/phase3-spikes/fgapp/*.app/

# Phase 3 eval: Ryan's real pastes contain copyrighted lyrics and must never be
# committed (R64); gold data and results derived from them name real songs.
research/phase3-eval/pastes/*
!research/phase3-eval/pastes/README.md
research/phase3-eval/gold.local.json
research/phase3-eval/results/

# P9-4 import corpus (spec 16.1): fetched pages, search pages, LRCLIB responses and gold
# files contain copyrighted lyrics and are never committed. Only the README, the URL list
# and the tools are tracked; committed fixtures are the redacted ones in the personal package.
research/phase9-import/pages/
research/phase9-import/search/
research/phase9-import/lrclib/
research/phase9-import/gold/
research/phase9-import/logs/

# User guide (WS6): dependencies, Astro state and the build output Pages rebuilds from source
guide/node_modules/
guide/.astro/
website/guide/

# The guide home, moved out of website/guide by guide/scripts/postbuild.mjs
website/guide.html

# fastlane deliver output (make store-upload, WS5 10)
store/report.xml
store/*.html
store/fastlane/
