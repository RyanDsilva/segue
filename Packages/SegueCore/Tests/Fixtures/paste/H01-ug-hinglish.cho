{title: Dil Ki Baatein}
{artist: Raahi Band}

{start_of_intro: Intro}
[Am]  [F]  [C]  [G]
{end_of_intro}

{start_of_verse: Verse 1}
[Am]Main chup hoon, bas [F]dekhta hoon
[C]Teri aankhon mein sapn[G]e kaise
[Am]Do pal ki yeh mulaqa[F]at hai
[C]Phir na milenge hum [G]aise
{end_of_verse}

{start_of_chorus: Chorus}
[F]Dil ki baatein, [C]dil hi jaane
[G]Kaun samjhe, kaun [Am]pehchaane
[F]Bas itna keh d[C]o, tum ho yahin
[G]Main aur kuch maang[Am]ta nahin
{end_of_chorus}

{start_of_verse: Verse 2}
[Am]Raat ki chaadar odh [F]ke
[C]Chaand bhi soya hai k[G]ahin
[Am]Tere bina yeh sheha[F]r mera
[C]Lagta hai apna nah[G]in
{end_of_verse}

{start_of_chorus: Chorus}
[F]Dil ki baatein, [C]dil hi jaane
[G]Kaun samjhe, kaun [Am]pehchaane
[F]Bas itna keh d[C]o, tum ho yahin
[G]Main aur kuch maang[Am]ta nahin
{end_of_chorus}

{start_of_outro: Outro}
[Am]  [F]  [C]  [G]  [Am]
{end_of_outro}
