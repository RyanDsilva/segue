{title: Chandni Raat}
{artist: Sufi Lanterns}

{start_of_chorus: Mukhda}
[G]Chandni raat hai, [D]tu bhi saath hai
[Em]Dil mein koi baat [C]hai
[G]Chandni raat hai, t[D]u bhi saath hai
[C]Yeh kaisi [D]saugaat [G]hai
{end_of_chorus}

{start_of_verse: Antara 1}
[G]Taaron ki chaadar odh [Em]ke
[C]Soya hai saara shehar[D]
[G]Hum tum jaage baithe h[Em]ain
[C]Bhool ke apni khaba[D]r
{end_of_verse}

{start_of_chorus: Mukhda}
[G]Chandni raat hai, [D]tu bhi saath hai
[Em]Dil mein koi baat [C]hai
[G]Chandni raat hai, t[D]u bhi saath hai
[C]Yeh kaisi [D]saugaat [G]hai
{end_of_chorus}

{start_of_bridge: Sanchari}
[Am]Waqt ruk jaaye ya[Em]hin
[C]Bas yahi dua hai me[D]ri
{end_of_bridge}

{start_of_chorus: Mukhda}
[G]Chandni raat hai, [D]tu bhi saath hai
[Em]Dil mein koi baat [C]hai
{end_of_chorus}
