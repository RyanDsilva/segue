{title: Chaand Ki Baatein}

{comment: Original Chords - D#, Cm, G#}

{start_of_intro: Intro}
[D#] [G#] [D#]
{end_of_intro}

{start_of_verse: Verse}
[D#]Chaand ki baatein [G#]karta hoon
[D#]Raat ki raani [Cm]khilti hai
[G#]Hawa mein khushboo [D#]bikhri hai
[G#]Dil ki baatein [D#]milti hai
{end_of_verse}

{start_of_chorus: Chorus}
[Cm]O saathiya, [G#]o saathiya
[D#]Tere bina [A#]kuch bhi nahi
[Cm]O saathiya, [G#]o saathiya
[D#]Tu hi meri [A#]zindagi
{end_of_chorus}

{start_of_instrumental: Music}
[D#] [G#]
{end_of_instrumental}
