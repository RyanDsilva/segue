{title: Jugnu}
{artist: Mehfil Collective}
{key: Em}

{start_of_intro: Intro}
[Em]  [C]  [G]  [D] (x2)
{end_of_intro}

{start_of_verse: Verse 1}
[Em]Andheri raat thi, gaon [C]soya tha
[G]Main chhat pe baitha, k[D]uch khoya tha
[Em]Ek jugnu aaya, roshni [C]laaya
[G]Bola mujhse, kyun gha[D]braaya
{end_of_verse}

{start_of_verse: Verse 2}
[Em]Maine kaha mujhe raast[C]a na dikhe
[G]Sapne mere saare kaagaz [D]pe likhe
[Em]Woh hans ke bola, chal [C]mere saath
[G]Andhere mein bhi hoti [D]hai baat
{end_of_verse}

{start_of_prechorus: Pre-Chorus}
[Am]Dheere dheere, [C]chalte chalte
[Am]Raaste khud ban [D]jaate hain
{end_of_prechorus}

{start_of_chorus: Chorus}
[G]Jugnu jugnu, [D]chamak zara
[Em]Raat ko de de t[C]hoda sahara
[G]Jugnu jugnu, [D]tu hai kahan
[Em]Tujh bin s[C]oona yeh j[G]ahaan
{end_of_chorus}

{start_of_verse: Verse 3}
[Em]Khet ke us paar nadi ba[C]hti thi
[G]Nani ki kahaani wahi keh[D]ti thi
[Em]Jo dar ke baitha, woh r[C]eh gaya
[G]Jo chal pada, woh beh [D]gaya
{end_of_verse}

{start_of_prechorus: Pre-Chorus}
[Am]Dheere dheere, [C]chalte chalte
[Am]Raaste khud ban [D]jaate hain
{end_of_prechorus}

{start_of_chorus: Chorus}
[G]Jugnu jugnu, [D]chamak zara
[Em]Raat ko de de t[C]hoda sahara
[G]Jugnu jugnu, [D]tu hai kahan
[Em]Tujh bin s[C]oona yeh j[G]ahaan
{end_of_chorus}

{start_of_instrumental: Instrumental}
[Em]  [C]  [G]  [D]
[Em]  [C]  [G]  [D]
{end_of_instrumental}

{start_of_bridge: Bridge}
[C]Main bhi ek jugnu [D]banoon
[Em]Kisi ka raasta ro[D]shan karoon
[C]Chhota sa hi sah[D]i magar
[Em]Andhere se na da[D]roon
{end_of_bridge}

{start_of_verse: Verse 4}
[Em]Ab subah hui, jugnu ch[C]ala gaya
[G]Par mujhko woh sab sikh[D]a gaya
[Em]Har raat ab main chhat [C]pe aata
[G]Uski roshni yaad dila[D]ata
{end_of_verse}

{start_of_chorus: Chorus}
[G]Jugnu jugnu, [D]chamak zara
[Em]Raat ko de de t[C]hoda sahara
[G]Jugnu jugnu, [D]tu hai kahan
[Em]Tujh bin s[C]oona yeh j[G]ahaan
{end_of_chorus}

{start_of_chorus: Chorus}
[G]Jugnu jugnu, [D]chamak zara
[Em]Raat ko de de t[C]hoda sahara
[G]Jugnu jugnu, [D]tu hai kahan
[Em]Tujh bin s[C]oona yeh j[G]ahaan
{end_of_chorus}

{start_of_outro: Outro}
[Em]  [C]  [G]  [D]  [Em]
{end_of_outro}
