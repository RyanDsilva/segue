<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- App Store flavor only. The set is asserted exactly by scripts/verify-archive.sh check 4;
     change both together. Never network.server, never a temporary-exception. -->
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Outgoing connections for the hosted services (docs/release/decisions.md R23, A61). -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Gig Mode Shortcuts run through Shortcuts Events (docs/release/decisions.md R59):
	     Apple events to the one Apple-published access group, no temporary exception. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.security.scripting-targets</key>
	<dict>
		<key>com.apple.shortcuts.events</key>
		<array>
			<string>com.apple.shortcuts.run</string>
		</array>
	</dict>
	<!-- Phase 3 (R67, R100): the downloaded-model store shared by both flavours. A
	     team-prefixed group needs no portal registration and no profile entry on macOS. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>V6BM673U35.dev.ryandsilva.segue.models</string>
	</array>
</dict>
</plist>
